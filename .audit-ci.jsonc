{
  // Fail the build on high (and critical) severity advisories in production
  // dependencies, matching the previous `npm audit --audit-level=high --omit=dev`.
  "high": true,
  "skip-dev": true,
  "allowlist": [
    // braces: recursive AST walkers lack depth guards, so deeply nested brace
    // patterns can exhaust the call stack. Every published version (<= 3.0.3)
    // is affected and there is no patched release, so this cannot be resolved
    // by upgrading or by an override. It reaches us only through
    // @docusaurus/core (chokidar, micromatch via @docusaurus/utils) and the
    // webpack toolchain, which expand glob patterns defined in this
    // repository's config at build/dev time, so attacker-controlled patterns
    // never reach it.
    // Remove this entry once braces ships a fix.
    "GHSA-vfj7-8cjw-p6xm"
  ]
}
